# Copy to .env and fill in. .env is gitignored; never commit it.

# Image to run. Pin a release tag (e.g. 1.0.0) for production; latest tracks master.
FIDOSIGS_IMAGE=ghcr.io/darrendignam/fidosigs
FIDOSIGS_TAG=latest

# Cloudflare Tunnel connector token, needed only for --profile tunnel.
#   Zero Trust -> Networks -> Tunnels -> (tunnel) -> Configure -> connector token
# Public hostname route: fidosigs.opf-labs.org -> HTTP -> web:5000
CLOUDFLARE_TUNNEL_TOKEN=

# Host port for docker-compose.local.yml.
# FIDOSIGS_LOCAL_PORT=8095

# Hosts with exhausted Docker address pools (see docker-compose.subnet.yml).
# COMPOSE_FILE=docker-compose.yml:docker-compose.subnet.yml
# FIDOSIGS_SUBNET=10.250.10.0/24
